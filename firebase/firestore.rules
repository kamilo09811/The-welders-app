rules_version = '2';
// TheWeldersWorld — reguły Firestore (produkcyjne).
// Powiadomienia in-app tworzą wyłącznie Cloud Functions (Admin SDK).
// Deploy: firebase deploy --only firestore:rules

function isSignedIn() {
  return request.auth != null;
}

function isSelf(userId) {
  return isSignedIn() && request.auth.uid == userId;
}

function onlyChatConversationMetaFields() {
  return request.resource.data.diff(resource.data).changedKeys().hasOnly([
    'lastMessageText',
    'lastMessageAt',
    'lastMessageSenderId',
    'updatedAt',
    'readAt',
    'mutedBy',
    'participantNames',
    'participantAvatars',
    'listingTitle',
  ]);
}

// Uwaga: `database` trzeba przekazać z match /databases/{database}/...
// — w helperach poza match `$(database)` bywa niezwiązane i exists/get zawsze failuje.
function validConversationCreate(database) {
  let d = request.resource.data;
  return d.keys().hasAll(['listingId', 'participantIds', 'pairKey'])
    && d.listingId is string
    && d.listingId.size() > 0
    && d.listingId.size() < 128
    && d.pairKey is string
    && d.pairKey.size() > 0
    && d.participantIds is list
    && d.participantIds.size() == 2
    && d.participantIds[0] is string
    && d.participantIds[1] is string
    && d.participantIds[0] != d.participantIds[1]
    && request.auth.uid in d.participantIds
    && exists(/databases/$(database)/documents/listings/$(d.listingId));
}

function validApplicationCreate(database) {
  let d = request.resource.data;
  let listingPath = /databases/$(database)/documents/listings/$(d.listingId);
  return d.keys().hasAll(['listingId', 'listingTitle', 'authorId', 'applicantId', 'status', 'message'])
    && d.listingId is string
    && d.listingId.size() > 0
    && d.listingTitle is string
    && d.authorId is string
    && d.authorId.size() > 0
    && d.applicantId is string
    && d.applicantId == request.auth.uid
    && d.authorId != request.auth.uid
    && d.status == 'new'
    && d.message is string
    && d.message.size() <= 2000
    && exists(listingPath)
    && get(listingPath).data.authorId == d.authorId;
}

function validApplicationStatusUpdate() {
  return request.resource.data.diff(resource.data).changedKeys().hasOnly(['status', 'updatedAt'])
    && request.resource.data.status in ['new', 'in_progress', 'accepted', 'rejected']
    && request.resource.data.listingId == resource.data.listingId
    && request.resource.data.authorId == resource.data.authorId
    && request.resource.data.applicantId == resource.data.applicantId;
}

function validNotificationReadUpdate() {
  return request.resource.data.diff(resource.data).changedKeys().hasOnly(['read', 'readAt'])
    && request.resource.data.read is bool
    && request.resource.data.kind == resource.data.kind
    && request.resource.data.actorUid == resource.data.actorUid
    && request.resource.data.recipientUid == resource.data.recipientUid;
}

function validReviewWrite(userId) {
  return request.auth.uid != userId
    && request.auth.uid == request.resource.data.reviewerId
    && request.resource.data.rating is number
    && request.resource.data.rating >= 1
    && request.resource.data.rating <= 5
    && request.resource.data.reviewerName is string
    && request.resource.data.text is string
    && request.resource.data.text.size() <= 2000;
}

function isQuickSlotSelfJoin() {
  // Kandydat może tylko dopisać siebie do quickSlots (1 miejsce).
  let before = resource.data;
  let after = request.resource.data;
  let beforeApplicants = ('quickSlots' in before && 'applicants' in before.quickSlots)
    ? before.quickSlots.applicants
    : [];
  let afterApplicants = after.quickSlots.applicants;
  return before.kind == 'quick'
    && after.kind == 'quick'
    && after.authorId == before.authorId
    && after.title == before.title
    && after.diff(before).changedKeys().hasOnly(['quickSlots', 'quickStatus', 'updatedAt'])
    && afterApplicants is list
    && afterApplicants.size() <= 5
    && afterApplicants.size() == beforeApplicants.size() + 1
    && afterApplicants[afterApplicants.size() - 1].uid == request.auth.uid
    && afterApplicants[afterApplicants.size() - 1].applicationId is string
    && afterApplicants[afterApplicants.size() - 1].name is string;
}

service cloud.firestore {
  match /databases/{database}/documents {

    // Profil publiczny marketplace: imię, miasto, bio, avatar, rola, emailVerified.
    // Telefon i inne dane wrażliwe: users/{uid}/meta/private (tylko właściciel).
    match /users/{userId} {
      allow read: if isSignedIn();
      // Telefon nie może być zapisywany/zmieniany na dokumencie publicznym
      // (użyj users/{uid}/meta/private). Istniejące pole phone można tylko usunąć
      // lub pozostawić bez zmian (migracja).
      allow create: if isSelf(userId)
        && !('phone' in request.resource.data);
      allow update: if isSelf(userId)
        && (
          !('phone' in request.resource.data)
          || (
            'phone' in resource.data
            && request.resource.data.phone == resource.data.phone
          )
        );
      allow delete: if isSelf(userId);

      // settings, push, private — tylko właściciel
      match /meta/{metaDocId} {
        allow read, write: if isSelf(userId);
      }

      // Tworzenie wyłącznie przez Cloud Functions (Admin SDK).
      match /notifications/{notifId} {
        allow read: if isSelf(userId);
        allow create: if false;
        allow update: if isSelf(userId) && validNotificationReadUpdate();
        allow delete: if isSelf(userId);
      }

      match /reviews/{reviewId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn()
          && request.auth.uid == reviewId
          && validReviewWrite(userId);
        allow delete: if isSignedIn() && request.auth.uid == reviewId;
      }
    }

    match /listings/{listingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.authorId
        && request.resource.data.authorId is string
        && request.resource.data.title is string;
      allow update: if isSignedIn()
        && (
          request.auth.uid == resource.data.authorId
          || isQuickSlotSelfJoin()
        );
      allow delete: if isSignedIn()
        && request.auth.uid == resource.data.authorId;
    }

    match /applications/{applicationId} {
      // get na nieistniejącym dokumencie: resource.data jest niedostępne —
      // pozwól zalogowanym sprawdzić istnienie (np. ID deterministyczne).
      allow get: if isSignedIn()
        && (
          !exists(/databases/$(database)/documents/applications/$(applicationId))
          || request.auth.uid == resource.data.applicantId
          || request.auth.uid == resource.data.authorId
        );
      allow list: if isSignedIn()
        && (request.auth.uid == resource.data.applicantId
            || request.auth.uid == resource.data.authorId);
      allow create: if isSignedIn() && validApplicationCreate(database);
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.authorId
        && validApplicationStatusUpdate();
      allow delete: if false;
    }

    match /conversations/{conversationId} {
      allow get: if isSignedIn()
        && (
          !exists(/databases/$(database)/documents/conversations/$(conversationId))
          || request.auth.uid in resource.data.participantIds
        );
      allow list: if isSignedIn()
        && request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn() && validConversationCreate(database);
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participantIds
        && onlyChatConversationMetaFields();
      allow delete: if false;
    }

    match /conversations/{conversationId}/messages/{messageId} {
      allow read: if isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
      allow create: if isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.keys().hasAll(['senderId', 'createdAt'])
        && (
          (request.resource.data.kind == 'text'
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 4000)
          ||
          (request.resource.data.kind == 'image'
            && request.resource.data.imageUrl is string
            && request.resource.data.imageUrl.size() > 0)
        );
      allow update, delete: if false;
    }
  }
}
